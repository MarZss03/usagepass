# Sandbox app credentials: developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Three sandbox accounts that receive collaborator shares (developer.paypal.com → Sandbox → Accounts).
# Use accounts other than the business account the app belongs to and other than the buyer you pay with.
PAYEE_LEAD_EMAIL=
PAYEE_ANIMATOR_EMAIL=
PAYEE_VOICE_EMAIL=

# Public https address of receiver.mjs, ending in /webhooks/paypal. Either:
#   a tunnel to your machine:  cloudflared tunnel --url http://localhost:5175  → https://<random>.trycloudflare.com/webhooks/paypal
#   or a Render deploy:        https://<service>.onrender.com/webhooks/paypal
# Then run `node spike.mjs webhook-setup` (re-run it whenever the URL changes).
WEBHOOK_URL=

# Printed by `node spike.mjs webhook-setup`. The receiver needs it to verify PayPal's signatures.
PAYPAL_WEBHOOK_ID=

# Optional: where spike.mjs asks the receiver for license state. Defaults to WEBHOOK_URL's origin.
# Set to http://localhost:5175 when using a tunnel, to skip the round trip.
RECEIVER_URL=
