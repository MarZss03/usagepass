# UsagePass configuration. Copy to .env (next to this file) and fill in.
# Values missing here are also read from spike/.env, so an existing spike setup works as is.

# PayPal sandbox app: developer.paypal.com → Apps & Credentials → Sandbox → your app (Payouts ticked).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhook id printed by `node spike/spike.mjs webhook-setup` (needed to verify PayPal's signatures).
# Point that webhook at https://<your public host>/webhooks/paypal.
PAYPAL_WEBHOOK_ID=

# Sandbox accounts that receive each collaborator's share (developer.paypal.com → Sandbox Accounts).
PAYEE_LEAD_EMAIL=
PAYEE_ANIMATOR_EMAIL=
PAYEE_VOICE_EMAIL=

# Google Gemini API key from aistudio.google.com (free tier works). Without it, a labelled
# offline keyword reader is used instead and the UI says so.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash          (default; answers in about 1-3 s)
# GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite   (tried when the first model is busy)

# Optional: public base URL used for PayPal return links (defaults to the request's host).
# PUBLIC_URL=https://usagepass.onrender.com
# PORT=5175
